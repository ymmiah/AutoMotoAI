<?xml version="1.0" encoding="utf-8"?>
<!-- Generated by packaging/branding/generate.py from automoto/brand.py. Paste into SignPath:
     Project > Artifact configurations > (new, or "default") > Edit. The workflow uploads one ZIP with both
     installers and passes the app version as the "version" parameter. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <!-- NSIS installer, AutoMoto-AI-Setup-<version>-Windows-x64.exe (version resource: ProductName / ProductVersion) -->
    <pe-file path="*.exe" product-name="AutoMoto AI" product-version="${version}">
      <authenticode-sign description="AutoMoto AI installer" description-url="https://ymmiah.github.io/AutoMotoAI/" />
    </pe-file>
    <!-- MSI, AutoMoto-AI-<version>-Windows-x64.msi: sign the app inside it (AutoMoto AI.exe), then the MSI itself -->
    <msi-file path="*.msi" subject="AutoMoto AI" author="Yasin Mohammed Miah">
      <pe-file path="**/*.exe" product-name="AutoMoto AI" product-version="${version}">
        <authenticode-sign description="AutoMoto AI" description-url="https://ymmiah.github.io/AutoMotoAI/" />
      </pe-file>
      <authenticode-sign description="AutoMoto AI installer" description-url="https://ymmiah.github.io/AutoMotoAI/" />
    </msi-file>
  </zip-file>
</artifact-configuration>
