; Generated by packaging/branding/generate.py from automoto/brand.py. Edit those, then re-run the script.
; Included at the top level of Tauri's NSIS template (bundle.windows.nsis.installerHooks).

VIAddVersionKey "CompanyName" "Yasin Mohammed Miah"
VIAddVersionKey "Comments" "The AI agent that does the work, and asks before anything risky"

!define MUI_WELCOMEPAGE_TITLE "Welcome to AutoMoto AI"
!define MUI_WELCOMEPAGE_TEXT "This will install AutoMoto AI on your computer.$\r$\n$\r$\nIt researches, writes Word, Excel and PowerPoint files, works with your data and code, and asks before anything risky.$\r$\n$\r$\nNo administrator rights are needed. Click Next to continue."
!define MUI_FINISHPAGE_TITLE "AutoMoto AI is ready"
!define MUI_FINISHPAGE_TEXT "AutoMoto AI is installed.$\r$\n$\r$\nSign in to your account to see the same chats on every device, or choose Local mode to run everything on this PC."
!define MUI_FINISHPAGE_LINK "Getting started guide"
!define MUI_FINISHPAGE_LINK_LOCATION "https://ymmiah.github.io/AutoMotoAI/START.html"
!define MUI_FINISHPAGE_LINK_COLOR "0F9D63"

!macro NSIS_HOOK_POSTINSTALL
  ; Add/Remove Programs: support and info links, publisher contact
  WriteRegStr SHCTX "${UNINSTKEY}" "HelpLink" "https://github.com/ymmiah/AutoMotoAI/issues"
  WriteRegStr SHCTX "${UNINSTKEY}" "URLInfoAbout" "https://ymmiah.github.io/AutoMotoAI/"
  WriteRegStr SHCTX "${UNINSTKEY}" "URLUpdateInfo" "https://github.com/ymmiah/AutoMotoAI/releases"
  WriteRegStr SHCTX "${UNINSTKEY}" "Contact" "Yasin Mohammed Miah"
  WriteRegStr SHCTX "${UNINSTKEY}" "Comments" "The AI agent that does the work, and asks before anything risky"
  ; installs before the Start menu folder existed put the shortcut in the Start menu root: keep only one
  Push $0
  Push $1
  Push $2
  Push $3
  ${If} $AppStartMenuFolder != ""
  ${AndIf} ${FileExists} "$SMPROGRAMS\$AppStartMenuFolder\${PRODUCTNAME}.lnk"
    !insertmacro IsShortcutTarget "$SMPROGRAMS\${PRODUCTNAME}.lnk" "$INSTDIR\${MAINBINARYNAME}.exe"
    Pop $0
    ${If} $0 = 1
      Delete "$SMPROGRAMS\${PRODUCTNAME}.lnk"
    ${EndIf}
  ${EndIf}
  Pop $3
  Pop $2
  Pop $1
  Pop $0
!macroend
