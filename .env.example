# AutoMoto AI v5 "Agent" - copy to .env and add at least ONE key.
# Keys stay on your machine. Placeholder values are ignored.

# Which AI answers first: auto | nim | gemini | groq | openrouter | openai | claude
# "auto" = pick the best configured AI for the task and fail over to the next.
AI_PROVIDER=auto
# A model your key can't use (404/410) is skipped for 1 h and the provider's next model is tried.
# Busy providers (429/5xx/timeouts) are retried with backoff first. `automoto doctor` tests every model.
# AUTOMOTO_RETRIES=2            # extra tries per model on 429/5xx/timeouts (0-5)
# AUTOMOTO_RETRY_BUDGET_S=20    # max total seconds spent waiting between retries per request

# ---- Free tiers -------------------------------------------------------------
# NVIDIA NIM  (https://build.nvidia.com)          vision: yes
NVIDIA_API_KEY=
# NIM_MODEL=meta/llama-3.2-11b-vision-instruct
# NIM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
# NIM_STRONG_MODEL=nvidia/nemotron-3-super-120b-a12b
# NIM_AGENT_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b   # used first for agent (tool-calling) steps
# NIM_REVIEW_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b  # careful page/slide reviews

# Google Gemini  (https://aistudio.google.com/apikey)   vision: yes
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_STRONG_MODEL=gemini-pro-latest

# Groq  (https://console.groq.com/keys)          vision: yes (preview model)
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STRONG_MODEL=openai/gpt-oss-120b
# GROQ_AGENT_MODEL=openai/gpt-oss-120b

# OpenRouter free models  (https://openrouter.ai/keys)   vision: yes
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_VISION_MODEL=google/gemma-4-31b-it:free

# ---- Paid (optional) --------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.4-mini
# OPENAI_STRONG_MODEL=gpt-5.5
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_STRONG_MODEL=claude-sonnet-4-6

# ---- Generation -------------------------------------------------------------
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=1500
# Agent steps (one tool call can hold a whole document spec); default max(AI_MAX_TOKENS, 8000)
# AI_AGENT_MAX_TOKENS=8000
AI_TIMEOUT=45

# ---- Agent (v5) ---------------------------------------------------------------
# State lives in ~/.automoto (memory.db, skills/, routines.json, workspace/). Override:
# AUTOMOTO_DATA_DIR=~/.automoto
# AUTOMOTO_WORKSPACE=~/.automoto/workspace     # the sandbox: all file + shell tools are jailed here
AUTOMOTO_MAX_STEPS=12            # agent step limit per task
AUTOMOTO_TOOL_MODE=auto          # auto | native | text  (text = JSON-in-text tool calls for any model)

# Approvals: ask (default) | auto (approve risky calls - only inside Docker!) | readonly (deny risky)
AUTOMOTO_APPROVAL=ask
# AUTOMOTO_AUTO_APPROVE=write_file          # tools that never ask (comma list)
# AUTOMOTO_BLOCK_TOOLS=open_app,type_text   # tools that never run

# Shell sandbox: auto (Docker if available, else local) | docker | local
AUTOMOTO_SANDBOX=auto
AUTOMOTO_SHELL_TIMEOUT=60
# AUTOMOTO_DOCKER_IMAGE=python:3.12-slim
# AUTOMOTO_DOCKER_NETWORK=none

# SSRF guard exceptions for fake-IP DNS proxies (Clash/Surge use 198.18.0.0/15). Leave empty normally.
# Loopback, link-local (169.254 cloud metadata) and "::" can never be allow-listed this way.
# AUTOMOTO_NET_ALLOW_CIDRS=198.18.0.0/15

# Optional MCP servers (stdio) - JSON file, see README
# AUTOMOTO_MCP_CONFIG=~/.automoto/mcp.json

# ---- Desktop tools & server -------------------------------------------------
AUTOMOTO_ENABLE_DESKTOP=1        # 0 = chat only
AUTOMOTO_ALLOW_SHELL=0           # 1 = allow run_command (still confirmed every time)
# AUTOMOTO_WORKDIR=~/AutoMoto    # where relative file/folder actions land
# AUTOMOTO_HOST=127.0.0.1
# AUTOMOTO_PORT=8765
# Needed only to let the mobile app reach this server over your LAN/VPN:
# AUTOMOTO_API_TOKEN=<long random string>
