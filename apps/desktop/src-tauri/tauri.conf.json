{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoMoto AI",
  "version": "5.1.0",
  "identifier": "com.ymmiah.automoto",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AutoMoto AI v4 · Cousin",
        "width": 1180,
        "height": 800,
        "minWidth": 720,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Multi-AI cousin assistant with auto-failover",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
